</style>
</head>
<body>
<div class="app">
<header class="topbar">
  <div class="brand"><span class="brandmark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 5.5c3.2-1.3 6-.7 8 1.2v12c-2-1.9-4.8-2.5-8-1.2v-12Z" stroke="white" stroke-width="1.7" stroke-linejoin="round"/><path d="M20 5.5c-3.2-1.3-6-.7-8 1.2v12c2-1.9 4.8-2.5 8-1.2v-12Z" stroke="white" stroke-width="1.7" stroke-linejoin="round"/><path d="m9 10 2 2 4-4" stroke="white" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>StudyMade<em>.AI</em></span></div>
  <div class="top-actions"><span class="pill">✦ PERSONAL LEARNING SPACE</span><button class="btn mobile-menu" id="mobileMenu" aria-label="Toggle navigation">☰</button><button class="btn subtle" id="settingsBtn">⚙ Settings</button><div class="avatar" aria-label="Student profile">S</div></div>
</header>
<div class="layout" id="layout">
<aside>
  <div><div class="nav-label">WORKSPACE</div><nav class="nav" aria-label="Main navigation">
    <button class="active" data-page="dashboard"><span class="ico">◫</span> Dashboard</button>
    <button data-page="study"><span class="ico">✧</span> AI Study Studio</button>
    <button data-page="quiz"><span class="ico">☑</span> Practice Quiz</button>
    <button data-page="cards"><span class="ico">▤</span> Flashcards</button>
    <button data-page="planner"><span class="ico">◷</span> Study Planner</button>
    <button data-page="library"><span class="ico">▣</span> My Library</button>
  </nav></div>
  <div><div class="nav-label">YOUR LEARNING</div><div class="side-note"><div class="spark">✦</div><strong>Small steps. Big progress.</strong><p>Learn a concept, test your knowledge, and return to what needs practice.</p><button class="btn small" data-go="study">Start a session →</button></div></div>
</aside>
<main class="main">
<section class="page active" id="page-dashboard">
  <div class="welcome"><div><div class="eyebrow">YOUR LEARNING OVERVIEW</div><h1>Make today a <span class="gradient-text">breakthrough.</span></h1><p>Your personal space to understand, practice, and remember more.</p></div><div class="date-chip" id="todayDate">Today</div></div>
  <div class="grid stats">
    <article class="stat"><div class="stat-head">Study materials <span class="stat-icon">▤</span></div><div class="stat-value" id="statMaterials">0</div><div class="stat-foot">Saved to your library</div></article>
    <article class="stat"><div class="stat-head">Tasks completed <span class="stat-icon">✓</span></div><div class="stat-value" id="statTasks">0/0</div><div class="stat-foot">Keep building momentum</div></article>
    <article class="stat"><div class="stat-head">Quiz accuracy <span class="stat-icon">◎</span></div><div class="stat-value" id="statAccuracy">—</div><div class="stat-foot">Based on answered questions</div></article>
    <article class="stat"><div class="stat-head">Practice questions <span class="stat-icon">✧</span></div><div class="stat-value" id="statQuestions">0</div><div class="stat-foot">Questions answered</div></article>
  </div>
  <div class="grid dashboard-grid">
    <div class="grid">
      <article class="card"><div class="card-head"><div><h2>Pick up where you left off</h2><p>Tools designed for your next study session.</p></div><button class="text-link" data-go="study">Open studio ↗</button></div>
        <div class="grid quick-grid">
          <button class="quick-tool" data-tool="assistant"><span class="tool-icon">🧠</span><strong>Understand a topic</strong><small>Build a clear study guide</small></button>
          <button class="quick-tool" data-tool="summary"><span class="tool-icon">📝</span><strong>Summarize notes</strong><small>Find key points quickly</small></button>
          <button class="quick-tool" data-tool="flashcards"><span class="tool-icon">🗂️</span><strong>Make flashcards</strong><small>Practice active recall</small></button>
          <button class="quick-tool" data-tool="quiz"><span class="tool-icon">🎯</span><strong>Test yourself</strong><small>Check what you know</small></button>
          <button class="quick-tool" data-tool="prompts"><span class="tool-icon">✨</span><strong>Study prompt</strong><small>Create a tutor prompt</small></button>
          <button class="quick-tool" data-go="planner"><span class="tool-icon">📅</span><strong>Plan your study</strong><small>Turn goals into tasks</small></button>
        </div>
      </article>
      <article class="card"><div class="card-head"><div><h2>Recent materials</h2><p>Your saved guides, notes, and practice sets.</p></div><button class="text-link" data-go="library">View library ↗</button></div><div id="recentMaterials" class="material-list"></div></article>
    </div>
    <div class="grid">
      <article class="card"><div class="card-head"><div><h2>Learning snapshot</h2><p>A quick look at your activity.</p></div><span class="status">Local data</span></div>
        <div class="progress-row"><div class="progress-label"><span>Task completion</span><span id="taskPercent">0%</span></div><div class="bar"><span id="taskBar"></span></div></div>
        <div class="progress-row"><div class="progress-label"><span>Quiz accuracy</span><span id="accuracyPercent">No attempts yet</span></div><div class="bar"><span id="accuracyBar"></span></div></div>
        <div class="callout">💡 <strong>Study tip:</strong> Try recalling an idea from memory before checking your notes. Short retrieval practice can make revision more active.</div>
      </article>
      <article class="card"><div class="card-head"><div><h2>Today's tasks</h2><button class="text-link" data-go="planner">Manage ↗</button></div><button class="btn small" data-go="planner">+ Add task</button></div><div id="dashboardTasks" class="task-list"></div></article>
    </div>
  </div>
  <p class="footer-note">StudyMade.AI · Demo workspace. Your materials are stored in this browser.</p>
</section>

<section class="page" id="page-study">
  <div class="section-title"><div class="eyebrow">AI STUDY STUDIO</div><h1>Turn notes into <span class="gradient-text">understanding.</span></h1><p>Choose a learning tool and work from your topic or source notes.</p></div>
  <div class="workspace-grid grid">
    <article class="card">
      <div class="field"><label for="toolSelect">Choose a tool</label><select id="toolSelect"><option value="assistant">🧠 Study guide</option><option value="summary">📝 Smart summary</option><option value="flashcards">🗂️ Flashcards</option><option value="quiz">🎯 Practice quiz</option><option value="prompts">✨ Study prompt</option></select></div>
      <div class="field"><label for="topic">Topic or title</label><input id="topic" maxlength="180" placeholder="e.g. Photosynthesis, Newton's laws"></div>
      <div class="field"><label for="notes">Your notes or study material</label><textarea id="notes" maxlength="30000" placeholder="Paste your notes, textbook excerpt, or key ideas here..."></textarea><div class="field-help"><span id="charCount">0</span>/30,000 characters · Your text stays in this browser unless you configure a backend.</div></div>
      <div class="field"><label for="difficulty">Learning level</label><select id="difficulty"><option value="beginner">Beginner — explain simply</option><option value="intermediate" selected>Intermediate — build understanding</option><option value="advanced">Advanced — go deeper</option></select></div>
      <div class="field"><label for="sourceFile">Import a text file (optional)</label><input type="file" id="sourceFile" accept=".txt,.md,.csv,text/plain,text/markdown,text/csv"><div class="field-help">Supports .txt, .md, and .csv files in this demo. PDF upload requires a document parser.</div></div>
      <div class="btn-row"><button class="btn primary" id="generateBtn">✦ Generate material</button><button class="btn" id="saveBtn">Save to library</button><button class="btn subtle" id="clearBtn">Clear</button></div>
      <div class="callout">Demo mode is active by default: outputs use transparent local text-processing rules, not a live AI model. Connect a secure backend in Settings to enable real model responses.</div>
    </article>
    <article class="card"><div class="card-head"><div><h2 id="outputTitle">Your study guide</h2><p id="outputSubtitle">Generated content appears here.</p></div><span class="status" id="modeBadge">Demo mode</span></div><div id="studyOutput" class="output" aria-live="polite" aria-atomic="true"></div><div class="btn-row" style="margin-top:14px"><button class="btn" id="copyOutputBtn">Copy output</button><button class="btn" id="useForQuizBtn">Practice this topic →</button></div></article>
  </div>
</section>

<section class="page" id="page-quiz">
  <div class="section-title"><div class="eyebrow">RETRIEVAL PRACTICE</div><h1>Check what <span class="gradient-text">you know.</span></h1><p>Create a practice set from your own notes and learn from each answer.</p></div>
  <div class="workspace-grid grid">
    <article class="card"><h2>Build a practice set</h2><div class="field"><label for="quizTopic">Topic</label><input id="quizTopic" placeholder="e.g. The water cycle"></div><div class="field"><label for="quizSource">Study material</label><textarea id="quizSource" placeholder="Paste notes here to create questions from your material..."></textarea></div><div class="field"><label for="questionCount">Number of questions</label><select id="questionCount"><option>3</option><option selected>5</option><option>8</option><option>10</option></select></div><button class="btn primary" id="buildQuizBtn">Create practice set →</button><div class="field-help">Questions are generated from sentences in your source text in demo mode. Review them for accuracy.</div></article>
    <article class="card"><div class="card-head"><div><h2 id="quizHeading">Practice area</h2><p id="quizProgress">Create a set to begin.</p></div><span class="pill" id="quizScore">Not started</span></div><div id="quizArea" class="output"></div><div class="btn-row" style="margin-top:14px"><button class="btn primary" id="checkAnswerBtn" disabled>Check answer</button><button class="btn" id="nextQuestionBtn" disabled>Next question →</button></div></article>
  </div>
</section>

<section class="page" id="page-cards">
  <div class="section-title"><div class="eyebrow">ACTIVE RECALL</div><h1>Remember it <span class="gradient-text">for longer.</span></h1><p>Generate cards from study notes, then flip through question and answer sides.</p></div>
  <div class="workspace-grid grid">
    <article class="card"><h2>Create flashcards</h2><div class="field"><label for="cardsTopic">Topic</label><input id="cardsTopic" placeholder="e.g. Cell biology"></div><div class="field"><label for="cardsSource">Study notes</label><textarea id="cardsSource" placeholder="Paste notes with clear sentences. Each useful sentence can become a card."></textarea></div><button class="btn primary" id="buildCardsBtn">Create flashcards →</button><div class="field-help">For best results, use notes containing complete, factual sentences.</div></article>
    <article class="card"><div class="card-head"><div><h2 id="cardsHeading">Your flashcards</h2><p id="cardsProgress">No cards yet</p></div><button class="btn small" id="saveCardsBtn" disabled>Save set</button></div><div id="cardStage" class="flashcard" tabindex="0" role="button" aria-label="Flip flashcard"><span class="label">READY TO LEARN</span><h3>Create a set to begin</h3><p>Click a card to flip it</p></div><div class="btn-row" style="justify-content:center;margin-top:14px"><button class="btn" id="prevCardBtn" disabled>← Previous</button><button class="btn primary" id="flipCardBtn" disabled>Flip card</button><button class="btn" id="nextCardBtn" disabled>Next →</button></div></article>
  </div>
</section>

<section class="page" id="page-planner">
  <div class="section-title"><div class="eyebrow">STUDY PLANNER</div><h1>Make a plan. <span class="gradient-text">Keep moving.</span></h1><p>Break your goals into manageable tasks and track your progress.</p></div>
  <div class="planner-grid grid">
    <article class="card"><div class="card-head"><div><h2>Your task list</h2><p id="plannerCount">No tasks yet</p></div><button class="btn small" id="clearCompletedBtn">Clear completed</button></div><div id="plannerTasks" class="task-list"></div></article>
    <article class="card"><h2>Add a study task</h2><form id="taskForm"><div class="field"><label for="taskTitle">Task</label><input id="taskTitle" maxlength="180" required placeholder="e.g. Review chapter 4"></div><div class="field"><label for="taskDate">Due date (optional)</label><input id="taskDate" type="date"></div><div class="field"><label for="taskPriority">Priority</label><select id="taskPriority"><option value="normal">Normal</option><option value="high">High</option><option value="low">Low</option></select></div><button class="btn primary" type="submit">＋ Add task</button></form><div class="callout">Tip: make each task specific enough to finish in one sitting.</div></article>
  </div>
</section>

<section class="page" id="page-library">
  <div class="section-title"><div class="eyebrow">YOUR PERSONAL LIBRARY</div><h1>Everything you <span class="gradient-text">save.</span></h1><p>Return to your generated study guides, summaries, cards, and quizzes.</p></div>
  <div class="card"><div class="toolbar"><div><h2>Saved materials</h2><p style="color:var(--muted);font-size:12px;margin:4px 0 0" id="libraryCount">0 items</p></div><input class="searchbox" id="librarySearch" placeholder="Search your library..." aria-label="Search saved materials"></div><div id="libraryItems" class="material-list"></div></div>
</section>
</main>
</div>
</div>

<div class="modal-backdrop" id="settingsModal" role="dialog" aria-modal="true" aria-labelledby="settingsTitle">
  <div class="modal"><div class="card-head"><div><h2 id="settingsTitle">AI connection settings</h2><p>Connect your own secure backend endpoint.</p></div><button class="btn small" id="closeSettingsBtn" aria-label="Close settings">✕</button></div>
    <div class="callout">Never paste a private API key into this page. Configure your model provider on a server and enter your backend endpoint below. The endpoint should accept JSON { "tool", "topic", "notes", "difficulty" } and return JSON { "text": "..." }.</div>
    <div class="field"><label for="backendUrl">Backend endpoint (optional)</label><input id="backendUrl" type="url" placeholder="https://your-domain.com/api/study"></div>
    <div class="field"><label><input type="checkbox" id="allowBackend" style="width:auto;margin-right:7px"> Enable backend requests for generated material</label></div>
    <p>When enabled, your topic and notes are sent to the endpoint you configure. Only connect a backend you trust. If the request fails, the app will explain the error rather than silently pretending AI worked.</p>
    <div class="btn-row"><button class="btn primary" id="saveSettingsBtn">Save settings</button><button class="btn" id="testBackendBtn">Test connection</button></div>
  </div>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>
(() => {
'use strict';
const $ = id => document.getElementById(id);
const KEYS = {tasks:'sm2_tasks', library:'sm2_library', stats:'sm2_stats', settings:'sm2_settings'};
const state = {tool:'assistant', output:'', outputData:null, cards:[], cardIndex:0, cardBack:false, quiz:[], quizIndex:0, selected:null, checked:false};
const toolNames = {assistant:'Study guide',summary:'Smart summary',flashcards:'Flashcards',quiz:'Practice quiz',prompts:'Study prompt'};
function read(key, fallback){try{const v=JSON.parse(localStorage.getItem(key));return v ?? fallback}catch{return fallback}}
function write(key,value){try{localStorage.setItem(key,JSON.stringify(value));return true}catch(e){toast('Could not save: browser storage may be full or disabled.');return false}}
function tasks(){return read(KEYS.tasks,[])}
function library(){return read(KEYS.library,[])}
function stats(){return read(KEYS.stats,{answered:0,correct:0})}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function toast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>t.classList.remove('show'),2800)}
function dateLabel(date){if(!date)return 'No due date';const d=new Date(date+'T12:00:00');return Number.isNaN(d.getTime())?date:d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
function sentences(text){return text.replace(/\s+/g,' ').split(/(?<=[.!?])\s+(?=[A-Z0-9"'(])/).map(s=>s.trim()).filter(s=>s.length>18)}
function sourceText(topic,notes){return notes.trim() || (topic.trim()?`${topic.trim()} is the topic to study. Add class notes or trusted source material for a more specific result.`:'')}
function getTopic(){return $('topic').value.trim() || 'Your study topic'}
function getNotes(){return $('notes').value.trim()}
function setPage(name){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id==='page-'+name));document.querySelectorAll('[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===name));$('layout').classList.remove('menu-open');if(name==='dashboard')renderDashboard();if(name==='planner')renderPlanner();if(name==='library')renderLibrary();if(name==='study')syncTool();window.scrollTo({top:0,behavior:'smooth'})}
function setTool(tool){state.tool=tool;$('toolSelect').value=tool;const title=toolNames[tool]||'Study guide';$('outputTitle').textContent=title;$('outputSubtitle').textContent='Generated content appears here.';setPage('study')}
document.querySelectorAll('[data-page]').forEach(b=>b.addEventListener('click',()=>setPage(b.dataset.page)));
document.querySelectorAll('[data-go]').forEach(b=>b.addEventListener('click',()=>setPage(b.dataset.go)));
document.querySelectorAll('[data-tool]').forEach(b=>b.addEventListener('click',()=>setTool(b.dataset.tool)));
$('toolSelect').addEventListener('change',()=>{state.tool=$('toolSelect').value;$('outputTitle').textContent=toolNames[state.tool];});
$('mobileMenu').addEventListener('click',()=>$('layout').classList.toggle('menu-open'));
$('notes').addEventListener('input',()=>$('charCount').textContent=$('notes').value.length);
$('sourceFile').addEventListener('change',async e=>{const f=e.target.files?.[0];if(!f)return;if(f.size>2*1024*1024){toast('Please choose a text file smaller than 2 MB.');e.target.value='';return}try{$('notes').value=await f.text();$('charCount').textContent=$('notes').value.length;if(!$('topic').value.trim())$('topic').value=f.name.replace(/\.[^.]+$/,'');toast('File imported. Review the text before generating.')}catch{toast('Could not read that file.')}});
function splitIntoStudyPoints(text){const ss=sentences(text);if(ss.length)return ss;const parts=text.split(/\n+|[,;]\s*/).map(x=>x.trim()).filter(x=>x.length>15);return parts.length?parts:[text.trim()].filter(Boolean)}
function localGenerate(tool,topic,notes,difficulty){
 const source=sourceText(topic,notes), points=splitIntoStudyPoints(source), title=esc(topic);
 if(tool==='summary'){
   const selected=points.slice(0,Math.min(6,points.length));
   return `<h3>Summary: ${title}</h3><p>This demo summary selects key-length statements from your input; it does not use a language model to infer importance.</p><h4>Key points from your material</h4><ul>${selected.map(p=>`<li>${esc(p)}</li>`).join('')}</ul><h4>Check your understanding</h4><p>Close your notes and explain the main idea in your own words. Which point needs more revision?</p>`;
 }
 if(tool==='assistant'){
   return `<h3>Study guide: ${title}</h3><p><b>Learning level:</b> ${esc(difficulty)}</p><h4>What your material says</h4><ul>${points.slice(0,8).map(p=>`<li>${esc(p)}</li>`).join('')}</ul><h4>Study this actively</h4><ol><li>Define the key terms from your notes without looking.</li><li>Explain how the main ideas connect.</li><li>Write one real-world example or worked example.</li><li>Check your explanation against your source material and correct gaps.</li></ol><div class="callout">Demo limitation: this guide organizes your supplied text and study steps. It does not independently verify facts or generate expert explanations.</div>`;
 }
 if(tool==='prompts'){
   return `<h3>Reusable tutor prompt: ${title}</h3><p>Copy this prompt into a trusted AI assistant:</p><div class="callout">Act as a patient tutor for <b>${title}</b>. My learning level is ${esc(difficulty)}. Use the notes below as the primary source. Explain one concept at a time, define technical terms, give a simple example, then ask me one practice question and wait for my answer. Correct misunderstandings kindly. Clearly identify anything the notes do not establish instead of guessing.<br><br><b>My notes:</b><br>${esc(source)}</div>`;
 }
 if(tool==='flashcards'){
   state.cards=makeCards(topic,source);state.cardIndex=0;state.cardBack=false;renderCards();
   return `<h3>Flashcard set created</h3><p>${state.cards.length} card(s) created from your text. Open the Flashcards section to review and flip them.</p><ul>${state.cards.slice(0,4).map(c=>`<li>${esc(c.q)}</li>`).join('')}</ul>`;
 }
 if(tool==='quiz'){
   state.quiz=makeQuiz(topic,source,5);state.quizIndex=0;state.selected=null;state.checked=false;renderQuiz();
   return `<h3>Practice set created</h3><p>${state.quiz.length} question(s) generated from sentences in your source. Open Practice Quiz to answer them and receive feedback.</p><button class="btn primary" onclick="document.querySelector('[data-page=quiz]').click()">Open practice quiz →</button>`;
 }
 return '';
}
async function generate(){
 const topic=getTopic(),notes=getNotes();if(!topic && !notes){toast('Enter a topic or some notes first.');return}
 const tool=state.tool,difficulty=$('difficulty').value,settings=read(KEYS.settings,{url:'',enabled:false});
 $('generateBtn').disabled=true;$('generateBtn').textContent='Generating…';$('studyOutput').innerHTML='<p>Preparing your learning material…</p>';
 try{
   if(settings.enabled && settings.url){
     $('modeBadge').textContent='Backend mode';
     let response;
     try{response=await fetch(settings.url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({tool,topic,notes,difficulty})})}
     catch(e){throw new Error('Could not reach your configured backend. Check the endpoint and server CORS settings.')}
     if(!response.ok)throw new Error(`Backend returned HTTP ${response.status}.`);
     const data=await response.json();if(typeof data.text!=='string'||!data.text.trim())throw new Error('Backend response must contain a non-empty "text" string.');
     state.outputData={tool,topic,notes,html:`<h3>${esc(toolNames[tool])}: ${esc(topic)}</h3><div>${esc(data.text).replace(/\n/g,'<br>')}</div>`,text:data.text};
   }else{
     $('modeBadge').textContent='Demo mode';
     const html=localGenerate(tool,topic,notes,difficulty);
     state.outputData={tool,topic,notes,html,text:$('studyOutput').innerText}; // replaced below with rendered text
     state.outputData.html=html;
   }
   state.output=state.outputData.html;$('studyOutput').innerHTML=state.output;
   state.outputData.text=$('studyOutput').innerText;
   $('outputSubtitle').textContent=`Created for ${topic}`;
   if(tool==='flashcards')toast(`Created ${state.cards.length} flashcards.`);
   else if(tool==='quiz')toast(`Created ${state.quiz.length} practice questions.`);
 }catch(e){$('studyOutput').innerHTML=`<div class="feedback bad"><strong>Generation failed.</strong><p>${esc(e.message||'Unexpected error.')}</p><p>Check your backend settings, or disable backend mode to use the local demo tools.</p></div>`;state.outputData=null;state.output='';}
 finally{$('generateBtn').disabled=false;$('generateBtn').textContent='✦ Generate material'}
}
$('generateBtn').addEventListener('click',generate);
$('clearBtn').addEventListener('click',()=>{$('topic').value='';$('notes').value='';$('charCount').textContent='0';$('studyOutput').innerHTML='';$('outputSubtitle').textContent='Generated content appears here.';state.output='';state.outputData=null;$('sourceFile').value='';toast('Workspace cleared.')});
$('saveBtn').addEventListener('click',()=>{if(!state.outputData){toast('Generate some material before saving.');return}const item={id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),title:state.outputData.topic||toolNames[state.outputData.tool],tool:state.outputData.tool,text:state.outputData.text,html:state.outputData.html,notes:state.outputData.notes,createdAt:new Date().toISOString()};const a=library();a.unshift(item);if(write(KEYS.library,a)){renderDashboard();toast('Saved to your library.')}});
$('copyOutputBtn').addEventListener('click',async()=>{const text=$('studyOutput').innerText.trim();if(!text){toast('There is no output to copy yet.');return}try{await navigator.clipboard.writeText(text);toast('Output copied.')}catch{toast('Clipboard access is unavailable in this browser. Select and copy the text manually.')}});
$('useForQuizBtn').addEventListener('click',()=>{if(!$('topic').value.trim()&&!$('notes').value.trim()){toast('Enter a topic or notes first.');return}$('quizTopic').value=$('topic').value;$('quizSource').value=$('notes').value;setPage('quiz')});
function makeCards(topic,source){
 let ps=splitIntoStudyPoints(source).filter(s=>s.length>25).slice(0,30);
 if(!ps.length)ps=[source];
 return ps.map((p,i)=>({q:`What is an important idea about ${topic||'this topic'}? (${i+1})`,a:p}));
}
function renderCards(){
 const c=state.cards,has=c.length>0;
 $('saveCardsBtn').disabled=!has;$('prevCardBtn').disabled=!has;$('flipCardBtn').disabled=!has;$('nextCardBtn').disabled=!has;
 if(!has){$('cardsProgress').textContent='No cards yet';$('cardStage').innerHTML='<span class="label">READY TO LEARN</span><h3>Create a set to begin</h3><p>Click a card to flip it</p>';return}
 const card=c[state.cardIndex];$('cardsHeading').textContent=$('cardsTopic').value.trim()||'Your flashcards';$('cardsProgress').textContent=`Card ${state.cardIndex+1} of ${c.length}`;
 $('cardStage').innerHTML=`<span class="label">${state.cardBack?'ANSWER':'QUESTION'} · ${state.cardIndex+1}/${c.length}</span><h3>${esc(state.cardBack?card.a:card.q)}</h3><p>Click the card or use the flip button</p>`;
}
function flipCard(){if(!state.cards.length)return;state.cardBack=!state.cardBack;renderCards()}
$('cardStage').addEventListener('click',flipCard);$('cardStage').addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();flipCard()}});
$('flipCardBtn').addEventListener('click',flipCard);
$('prevCardBtn').addEventListener('click',()=>{if(state.cards.length){state.cardIndex=(state.cardIndex-1+state.cards.length)%state.cards.length;state.cardBack=false;renderCards()}});
$('nextCardBtn').addEventListener('click',()=>{if(state.cards.length){state.cardIndex=(state.cardIndex+1)%state.cards.length;state.cardBack=false;renderCards()}});
$('buildCardsBtn').addEventListener('click',()=>{const topic=$('cardsTopic').value.trim()||'Study topic',source=$('cardsSource').value.trim();if(!source){toast('Paste some notes first so cards can be based on your material.');return}state.cards=makeCards(topic,source);state.cardIndex=0;state.cardBack=false;renderCards();toast(`Created ${state.cards.length} cards.`)});
$('saveCardsBtn').addEventListener('click',()=>{if(!state.cards.length)return;const item={id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),title:$('cardsTopic').value.trim()||'Flashcards',tool:'flashcards',text:state.cards.map((c,i)=>`${i+1}. Q: ${c.q}\nA: ${c.a}`).join('\n\n'),cards:state.cards,createdAt:new Date().toISOString()};const a=library();a.unshift(item);if(write(KEYS.library,a)){renderDashboard();toast('Flashcards saved to library.')}});
function makeQuiz(topic,source,count){
 let ps=splitIntoStudyPoints(source).filter(s=>s.length>20);
 if(!ps.length)ps=[source||`Review the key ideas in ${topic}.`];
 return ps.slice(0,count).map((sentence,i)=>{
   const answer=sentence.replace(/[.!?]+$/,'').trim();
   const wrongs=[`The material does not mention ${topic}.`,`This statement contradicts the supplied notes.`,`The main idea is unrelated to ${topic}.`];
   const opts=[answer,...wrongs.slice(0,3)].map((text,j)=>({text,correct:j===0}));
   // Stable order makes the correct answer position predictable only within this transparent demo; shuffle the options.
   for(let k=opts.length-1;k>0;k--){const j=Math.floor(Math.random()*(k+1));[opts[k],opts[j]]=[opts[j],opts[k]]}
   return {question:`Which statement matches your source material?`,context:`Statement ${i+1} about ${topic||'your topic'}`,options:opts,explanation:`Compare each option with your original notes. The supported statement is: “${answer}.”`};
 });
}
function renderQuiz(){
 const q=state.quiz[state.quizIndex];if(!q){$('quizArea').innerHTML='<p>Create a practice set from your notes to get started.</p>';$('quizProgress').textContent='Create a set to begin.';$('quizScore').textContent='Not started';$('checkAnswerBtn').disabled=true;$('nextQuestionBtn').disabled=true;return}
 $('quizHeading').textContent='Practice question';$('quizProgress').textContent=`Question ${state.quizIndex+1} of ${state.quiz.length}`;$('quizScore').textContent=state.checked?'Answer reviewed':'Choose one answer';
 $('quizArea').innerHTML=`<h3>${esc(q.question)}</h3><p>${esc(q.context)}</p>${q.options.map((o,i)=>`<button class="quiz-option ${state.selected===i?'selected':''} ${state.checked&&o.correct?'correct':''} ${state.checked&&state.selected===i&&!o.correct?'wrong':''}" data-option="${i}" ${state.checked?'disabled':''}><span class="option-letter">${String.fromCharCode(65+i)}</span><span>${esc(o.text)}</span></button>`).join('')}${state.checked?`<div class="feedback ${q.options[state.selected]?.correct?'good':'bad'}"><strong>${q.options[state.selected]?.correct?'Good work.':'Review this point.'}</strong><p>${esc(q.explanation)}</p></div>`:''}`;
 $('quizArea').querySelectorAll('[data-option]').forEach(b=>b.addEventListener('click',()=>{if(state.checked)return;state.selected=Number(b.dataset.option);renderQuiz()}));
 $('checkAnswerBtn').disabled=state.selected===null||state.checked;$('nextQuestionBtn').disabled=!state.checked;$('nextQuestionBtn').textContent=state.quizIndex===state.quiz.length-1?'Finish practice':'Next question →';
}
$('buildQuizBtn').addEventListener('click',()=>{const source=$('quizSource').value.trim();if(!source){toast('Paste study material to build questions from it.');return}state.quiz=makeQuiz($('quizTopic').value.trim()||'your topic',source,Number($('questionCount').value));state.quizIndex=0;state.selected=null;state.checked=false;renderQuiz();toast(`Created ${state.quiz.length} questions. Review the wording against your notes.`)});
$('checkAnswerBtn').addEventListener('click',()=>{if(state.selected===null||state.checked)return;state.checked=true;const correct=!!state.quiz[state.quizIndex].options[state.selected].correct;const s=stats();s.answered++;if(correct)s.correct++;write(KEYS.stats,s);renderQuiz();renderDashboard()});
$('nextQuestionBtn').addEventListener('click',()=>{if(!state.checked)return;if(state.quizIndex<state.quiz.length-1){state.quizIndex++;state.selected=null;state.checked=false;renderQuiz()}else{const s=stats();$('quizArea').innerHTML=`<h3>Practice complete 🎉</h3><p>You have answered ${s.answered} question(s) across your sessions, with ${s.correct} correct.</p><p>Review the original material and retry any concepts that felt uncertain.</p><button class="btn primary" id="retryQuizBtn">Review this set again</button>`;$('quizProgress').textContent='Set completed';$('quizScore').textContent='Complete';$('checkAnswerBtn').disabled=true;$('nextQuestionBtn').disabled=true;$('retryQuizBtn').addEventListener('click',()=>{state.quizIndex=0;state.selected=null;state.checked=false;renderQuiz()})}renderDashboard()});
$('taskForm').addEventListener('submit',e=>{e.preventDefault();const title=$('taskTitle').value.trim();if(!title)return;const a=tasks();a.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),title,due:$('taskDate').value,priority:$('taskPriority').value,done:false,createdAt:new Date().toISOString()});if(write(KEYS.tasks,a)){e.target.reset();renderPlanner();renderDashboard();toast('Task added. One step closer.')}});
function taskMarkup(t,compact=false){return `<div class="task-row ${t.done?'completed':''}"><input class="check" type="checkbox" data-task-check="${esc(t.id)}" ${t.done?'checked':''} aria-label="Mark ${esc(t.title)} complete"><div class="task-info"><strong>${esc(t.title)}</strong><small>${t.due?'Due '+esc(dateLabel(t.due))+' · ':''}${esc((t.priority||'normal').toUpperCase())} priority</small></div>${compact?'':`<button class="btn small danger" data-task-delete="${esc(t.id)}" aria-label="Delete ${esc(t.title)}">✕</button>`}</div>`}
function bindTaskActions(root){root.querySelectorAll('[data-task-check]').forEach(el=>el.addEventListener('change',()=>{const a=tasks().map(t=>String(t.id)===el.dataset.taskCheck?{...t,done:el.checked}:t);write(KEYS.tasks,a);renderPlanner();renderDashboard()}));root.querySelectorAll('[data-task-delete]').forEach(el=>el.addEventListener('click',()=>{write(KEYS.tasks,tasks().filter(t=>String(t.id)!==el.dataset.taskDelete));renderPlanner();renderDashboard();toast('Task removed.')}))}
function renderPlanner(){const a=tasks().sort((x,y)=>Number(x.done)-Number(y.done)||((x.due||'9999').localeCompare(y.due||'9999')));const done=a.filter(t=>t.done).length;$('plannerCount').textContent=`${done} of ${a.length} completed`;const box=$('plannerTasks');box.innerHTML=a.length?a.map(t=>taskMarkup(t)).join(''):'<div class="empty">No tasks yet. Add one small, specific goal to get started.</div>';bindTaskActions(box)}
$('clearCompletedBtn').addEventListener('click',()=>{const a=tasks().filter(t=>!t.done);write(KEYS.tasks,a);renderPlanner();renderDashboard();toast('Completed tasks cleared.')});
function materialMarkup(x){return `<div class="material-row"><div class="stat-icon">▤</div><div class="material-info"><strong>${esc(x.title||'Study material')}</strong><small>${esc(toolNames[x.tool]||x.tool||'Material')} · ${esc(new Date(x.createdAt||Date.now()).toLocaleDateString())}</small></div><button class="btn small" data-material-open="${esc(x.id)}">Open</button><button class="btn small danger" data-material-delete="${esc(x.id)}" aria-label="Delete ${esc(x.title)}">✕</button></div>`}
function bindMaterials(root){root.querySelectorAll('[data-material-open]').forEach(b=>b.addEventListener('click',()=>{const x=library().find(i=>String(i.id)===b.dataset.materialOpen);if(!x)return;if(x.cards){state.cards=x.cards;state.cardIndex=0;state.cardBack=false;renderCards();setPage('cards');return}state.tool=x.tool||'assistant';$('toolSelect').value=state.tool;$('topic').value=x.title||'';$('notes').value=x.notes||x.text||'';$('charCount').textContent=$('notes').value.length;$('outputTitle').textContent=toolNames[state.tool]||'Study material';$('studyOutput').innerHTML=x.html||`<h3>${esc(x.title)}</h3><p>${esc(x.text||'')}</p>`;state.outputData=x;state.output=x.html||'';setPage('study')}));root.querySelectorAll('[data-material-delete]').forEach(b=>b.addEventListener('click',()=>{write(KEYS.library,library().filter(i=>String(i.id)!==b.dataset.materialDelete));renderLibrary();renderDashboard();toast('Material deleted.')}))}
function renderLibrary(){const query=$('librarySearch').value.trim().toLowerCase();const all=library(),a=all.filter(x=>(x.title+' '+(toolNames[x.tool]||x.tool)+' '+(x.text||'')).toLowerCase().includes(query));$('libraryCount').textContent=`${all.length} saved item${all.length===1?'':'s'}`;$('libraryItems').innerHTML=a.length?a.map(materialMarkup).join(''):'<div class="empty">No matching materials. Generate a guide, summary, or practice set and save it here.</div>';bindMaterials($('libraryItems'))}
$('librarySearch').addEventListener('input',renderLibrary);
function renderDashboard(){
 const ts=tasks(),done=ts.filter(t=>t.done).length,lib=library(),s=stats(),pct=ts.length?Math.round(done/ts.length*100):0,acc=s.answered?Math.round(s.correct/s.answered*100):null;
 $('todayDate').textContent=new Date().toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric',year:'numeric'});
 $('statMaterials').textContent=lib.length;$('statTasks').textContent=`${done}/${ts.length}`;$('statAccuracy').textContent=acc===null?'—':acc+'%';$('statQuestions').textContent=s.answered;
 $('taskPercent').textContent=pct+'%';$('taskBar').style.width=pct+'%';$('accuracyPercent').textContent=acc===null?'No attempts yet':acc+'%';$('accuracyBar').style.width=(acc||0)+'%';
 const recent=$('recentMaterials');recent.innerHTML=lib.length?lib.slice(0,4).map(materialMarkup).join(''):'<div class="empty">Your saved materials will appear here.</div>';bindMaterials(recent);
 const todo=$('dashboardTasks'),pending=ts.filter(t=>!t.done).slice(0,4);todo.innerHTML=pending.length?pending.map(t=>taskMarkup(t,true)).join(''):'<div class="empty">All caught up — or add a task to plan your next session.</div>';bindTaskActions(todo)
}
function syncTool(){state.tool=$('toolSelect').value;$('outputTitle').textContent=toolNames[state.tool]}
const settings=read(KEYS.settings,{url:'',enabled:false});
function openSettings(){$('backendUrl').value=settings.url||'';$('allowBackend').checked=!!settings.enabled;$('settingsModal').classList.add('show')}
function closeSettings(){$('settingsModal').classList.remove('show')}
$('settingsBtn').addEventListener('click',openSettings);$('closeSettingsBtn').addEventListener('click',closeSettings);$('settingsModal').addEventListener('click',e=>{if(e.target===$('settingsModal'))closeSettings()});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeSettings()});
$('saveSettingsBtn').addEventListener('click',()=>{const url=$('backendUrl').value.trim(),enabled=$('allowBackend').checked;if(enabled&&!url){toast('Enter a backend endpoint or disable backend mode.');return}if(url){try{new URL(url)}catch{toast('Enter a valid endpoint URL.');return}}const ok=write(KEYS.settings,{url,enabled});if(ok){Object.assign(settings,{url,enabled});closeSettings();toast(enabled?'Backend mode enabled. Requests will send your notes to this endpoint.':'Settings saved. Local demo mode is active.')}});
$('testBackendBtn').addEventListener('click',async()=>{const url=$('backendUrl').value.trim();if(!url){toast('Enter your backend endpoint first.');return}try{const r=await fetch(url,{method:'OPTIONS'});toast(`Endpoint responded with HTTP ${r.status}. This does not confirm model generation works.`)}catch{toast('Could not reach endpoint. Check URL, server status, and CORS settings.')}});
renderCards();renderQuiz();renderPlanner();renderLibrary();renderDashboard();
})();
</script>
</body>
