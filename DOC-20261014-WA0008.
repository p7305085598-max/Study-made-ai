<title>StudyMade.AI — Your Personal Learning Workspace</title>
<style>
:root{--bg:#0b0b12;--surface:#12121c;--surface2:#181824;--border:#2b2b3b;--text:#f4f3fb;--muted:#a3a2b8;--purple:#8b73ff;--pink:#ff6caa;--mint:#62e6b5;--yellow:#ffd477;--danger:#ff7889;--radius:18px;--shadow:0 18px 60px #0003}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 20% -10%,#493b8533,transparent 42%),var(--bg);color:var(--text);font:15px/1.55 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid #a18fff;outline-offset:2px}button:disabled{opacity:.45;cursor:not-allowed}.app{max-width:1440px;margin:auto;min-height:100vh}.topbar{height:76px;padding:0 30px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:20px;position:sticky;top:0;background:#0b0b12eF;backdrop-filter:blur(16px);z-index:10}.brand{display:flex;align-items:center;gap:11px;font-size:20px;font-weight:800;letter-spacing:-.6px}.brandmark{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,var(--purple),var(--pink));box-shadow:0 6px 24px #8b73ff40}.brandmark svg{width:22px;height:22px}.brand em{font-style:normal;color:#ad9dff}.top-actions{display:flex;align-items:center;gap:10px}.pill{font-size:12px;padding:6px 10px;border:1px solid #3b365c;border-radius:999px;color:#c9c0ff;background:#8b73ff12}.avatar{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:#29253f;color:#d6ceff;font-weight:800}.layout{display:grid;grid-template-columns:238px minmax(0,1fr);min-height:calc(100vh - 76px)}aside{border-right:1px solid var(--border);padding:26px 16px;display:flex;flex-direction:column;gap:25px}.nav-label{font-size:10px;letter-spacing:1.7px;color:#74748d;font-weight:800;padding:0 12px 8px}.nav{display:grid;gap:6px}.nav button{width:100%;display:flex;align-items:center;gap:12px;text-align:left;padding:11px 13px;border:1px solid transparent;border-radius:12px;background:transparent;color:var(--muted)}.nav button:hover{background:#ffffff08;color:var(--text)}.nav button.active{background:#8b73ff1b;border-color:#8b73ff40;color:#d6ceff}.nav .ico{width:20px;text-align:center;font-size:17px}.side-note{margin-top:auto;border:1px solid var(--border);background:linear-gradient(145deg,#1b1830,#151521);border-radius:16px;padding:16px}.side-note strong{display:block;margin:7px 0}.side-note p{font-size:12px;color:var(--muted);margin:0 0 12px}.side-note .spark{font-size:22px}.main{padding:30px clamp(18px,3vw,42px) 60px;min-width:0}.page{display:none;animation:fade .22s ease}.page.active{display:block}@keyframes fade{from{opacity:.5;transform:translateY(4px)}to{opacity:1;transform:none}}.welcome{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin:4px 0 25px}.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:1.8px;color:#b3a6ff;font-weight:800}.welcome h1{font-size:clamp(27px,3vw,38px);letter-spacing:-1.3px;line-height:1.18;margin:7px 0}.welcome p{margin:0;color:var(--muted)}.date-chip{white-space:nowrap;border:1px solid var(--border);border-radius:12px;padding:10px 13px;color:var(--muted);font-size:12px}.gradient-text{background:linear-gradient(95deg,#b8a9ff,var(--pink));color:transparent;background-clip:text}.grid{display:grid;gap:16px}.stats{grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:22px}.stat,.card{border:1px solid var(--border);background:linear-gradient(145deg,#171722,#11111a);border-radius:var(--radius);box-shadow:var(--shadow)}.stat{padding:18px}.stat-head{display:flex;align-items:center;justify-content:space-between;color:var(--muted);font-size:12px}.stat-icon{width:34px;height:34px;display:grid;place-items:center;border-radius:11px;background:#8b73ff1c;font-size:17px}.stat-value{font-size:29px;line-height:1.2;font-weight:800;margin:12px 0 5px;letter-spacing:-1px}.stat-foot{font-size:11px;color:var(--muted)}.dashboard-grid{grid-template-columns:minmax(0,1.45fr) minmax(270px,.85fr)}.card{padding:22px;min-width:0}.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:18px}.card h2,.card h3{margin:0;letter-spacing:-.4px}.card h2{font-size:18px}.card h3{font-size:15px}.card-head p{margin:4px 0 0;color:var(--muted);font-size:12px}.text-link{background:transparent;border:0;color:#b8a9ff;font-size:12px;padding:4px}.text-link:hover{text-decoration:underline}.quick-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.quick-tool{min-height:135px;padding:17px;border-radius:15px;border:1px solid var(--border);background:#ffffff04;text-align:left;color:var(--text);transition:.18s}.quick-tool:hover{transform:translateY(-2px);border-color:#8270e7;background:#8b73ff0c}.quick-tool .tool-icon{font-size:22px;display:block;margin-bottom:14px}.quick-tool strong{display:block;font-size:13px}.quick-tool small{display:block;color:var(--muted);font-size:11px;margin-top:4px;line-height:1.4}.progress-row{margin:17px 0}.progress-label{display:flex;justify-content:space-between;gap:10px;font-size:12px;margin-bottom:7px}.progress-label span:last-child{color:var(--muted)}.bar{height:7px;border-radius:20px;background:#292938;overflow:hidden}.bar span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--purple),var(--pink));border-radius:20px;transition:width .3s}.task-list,.material-list{display:grid;gap:9px}.task-row,.material-row{display:flex;align-items:center;gap:11px;padding:12px;border:1px solid var(--border);border-radius:12px;background:#ffffff03}.check{width:18px;height:18px;accent-color:var(--purple);flex-shrink:0}.task-info,.material-info{min-width:0;flex:1}.task-info strong,.material-info strong{display:block;font-size:13px;overflow-wrap:anywhere}.task-info small,.material-info small{display:block;font-size:11px;color:var(--muted);margin-top:2px}.task-row.completed strong{text-decoration:line-through;color:var(--muted)}.empty{padding:24px 14px;text-align:center;color:var(--muted);font-size:13px;border:1px dashed var(--border);border-radius:13px}.btn{display:inline-flex;justify-content:center;align-items:center;gap:8px;border:1px solid var(--border);background:#20202d;color:var(--text);padding:10px 14px;border-radius:11px;font-weight:650;font-size:12px;transition:.15s}.btn:hover{border-color:#7e6be3;transform:translateY(-1px)}.btn.primary{background:linear-gradient(105deg,#8068f7,#9c70f7);border-color:transparent;color:white;box-shadow:0 7px 20px #8b73ff24}.btn.subtle{background:transparent}.btn.danger{color:#ff9eaa}.btn.small{padding:7px 10px;font-size:11px}.btn-row{display:flex;gap:9px;flex-wrap:wrap}.field{margin:15px 0}.field label{display:block;font-size:12px;color:#c2c0d3;font-weight:650;margin-bottom:7px}.field input,.field textarea,.field select,.searchbox{width:100%;border:1px solid var(--border);background:#0c0c14;color:var(--text);border-radius:11px;padding:12px 13px}.field textarea{min-height:150px;resize:vertical}.field input::placeholder,.field textarea::placeholder{color:#696980}.field select{appearance:auto}.field-help{font-size:11px;color:var(--muted);margin-top:6px}.workspace-grid{grid-template-columns:minmax(260px,.8fr) minmax(0,1.2fr);align-items:start}.output{min-height:230px;background:#0d0d15;border:1px solid var(--border);border-radius:13px;padding:18px;overflow-wrap:anywhere}.output:empty:before{content:"Your generated learning material will appear here.";color:#77768d;font-size:13px}.output h3{margin:0 0 12px}.output h4{margin:18px 0 7px;color:#cfc5ff}.output p{margin:9px 0;color:#d3d2df}.output ul,.output ol{padding-left:22px}.output li{margin:7px 0;color:#d3d2df}.callout{border:1px solid #4a3f77;background:#8b73ff0c;padding:12px;border-radius:11px;color:#cfc5ff;font-size:12px;margin:12px 0}.status{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:#a9e9d0;background:#62e6b510;border:1px solid #62e6b52b;border-radius:999px;padding:5px 9px}.status:before{content:"";width:6px;height:6px;border-radius:50%;background:var(--mint)}.flashcard{min-height:230px;border:1px solid #7867dc;background:radial-gradient(ellipse at top,#8b73ff20,transparent 75%),#10101a;border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;cursor:pointer}.flashcard .label{font-size:10px;text-transform:uppercase;letter-spacing:2px;color:#b8a9ff}.flashcard h3{font-size:22px;max-width:560px;margin:17px 0}.flashcard p{font-size:12px;color:var(--muted);margin:0}.quiz-option{display:flex;align-items:flex-start;gap:10px;width:100%;padding:12px;text-align:left;border:1px solid var(--border);background:#ffffff03;color:var(--text);border-radius:11px;margin:9px 0}.quiz-option:hover{border-color:#7e6be3}.quiz-option.selected{border-color:var(--purple);background:#8b73ff18}.quiz-option.correct{border-color:#4cbf94;background:#62e6b511}.quiz-option.wrong{border-color:#e76d80;background:#ff788911}.option-letter{width:24px;height:24px;flex-shrink:0;border-radius:7px;display:grid;place-items:center;background:#272638;color:#d6ceff;font-size:11px;font-weight:800}.feedback{padding:13px;border-radius:11px;margin-top:12px;font-size:12px}.feedback.good{background:#62e6b510;border:1px solid #62e6b53b;color:#9be9cc}.feedback.bad{background:#ff78890e;border:1px solid #ff78893b;color:#ffb5bf}.section-title{margin:4px 0 20px}.section-title h1{font-size:30px;letter-spacing:-1px;margin:0 0 5px}.section-title p{color:var(--muted);margin:0}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:17px;flex-wrap:wrap}.toolbar .searchbox{max-width:300px}.planner-grid{grid-template-columns:minmax(0,1fr) minmax(260px,.7fr);align-items:start}.toast{position:fixed;bottom:22px;right:22px;max-width:min(360px,calc(100vw - 44px));padding:13px 17px;border:1px solid #4a4273;background:#1b1930;border-radius:13px;box-shadow:var(--shadow);font-size:13px;z-index:50;opacity:0;transform:translateY(10px);pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:none}.modal-backdrop{position:fixed;inset:0;background:#0009;display:none;place-items:center;padding:20px;z-index:40}.modal-backdrop.show{display:grid}.modal{width:min(500px,100%);background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:24px;box-shadow:var(--shadow)}.modal h2{margin:0 0 8px}.modal p{font-size:13px;color:var(--muted)}.modal .field{margin:12px 0}.footer-note{font-size:11px;color:#77768d;text-align:center;margin:26px 0 0}.hidden{display:none!important}.mobile-menu{display:none}
@media(max-width:1050px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.dashboard-grid{grid-template-columns:1fr}.workspace-grid,.planner-grid{grid-template-columns:1fr}.quick-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:720px){.topbar{padding:0 16px;height:66px}.brand{font-size:17px}.pill{display:none}.mobile-menu{display:inline-flex}.layout{grid-template-columns:1fr}aside{display:none;border-right:0;border-bottom:1px solid var(--border);padding:12px 16px}.layout.menu-open aside{display:block}.layout.menu-open aside .nav{grid-template-columns:repeat(2,minmax(0,1fr))}.layout.menu-open aside .side-note{display:none}.main{padding:24px 16px 45px}.welcome{display:block}.date-chip{display:inline-block;margin-top:14px}.quick-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.card{padding:17px}.stats{gap:10px}.stat{padding:14px}.stat-value{font-size:25px}.section-title h1{font-size:26px}}
